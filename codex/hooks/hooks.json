{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|exec_command|mcp__.*(?:dataforseo|ahrefs|seranking|se-ranking|firecrawl|profound|banana).*__.*)$",
        "hooks": [
          {"type": "command", "command": "node \"${PLUGIN_ROOT}/codex/hooks/dispatch.js\" paid", "timeout": 30, "statusMessage": "Checking SEO API authorization"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {"type": "command", "command": "node \"${PLUGIN_ROOT}/codex/hooks/dispatch.js\"", "timeout": 30, "statusMessage": "Checking edited JSON-LD"}
        ]
      }
    ]
  }
}
